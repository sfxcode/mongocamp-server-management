# MongoCamp server the console talks to
MONGOCAMP_URL=https://your-mongocamp-server.example.com
# Used by scripts/shots.mjs to sign in for screenshots
MONGOCAMP_ADMIN_USER=
MONGOCAMP_ADMIN_PASSWORD=

# Server proxy mode (optional): an API key on the server instead of a login
MONGOCAMP_USE_SERVER_PROXY=false
MONGOCAMP_API_KEY=
# Callers of the proxy route must then send this value as x-mongocamp-proxy-secret
MONGOCAMP_PROXY_SHARED_SECRET=
